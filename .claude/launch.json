{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "echo-backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "echo-frontend",
      "runtimeExecutable": "cmd",
      "runtimeArgs": ["/c", "npm", "run", "dev", "--prefix", "frontend"],
      "port": 3000
    }
  ]
}
